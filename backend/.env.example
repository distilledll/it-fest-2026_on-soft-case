# Скопируй в backend/.env. Ключи в код, презентацию и логи НЕ кладём (требование кейса).

# Пайплайн по умолчанию: stub | baseline | agent
PIPELINE=agent

# Профиль модели по умолчанию — создаётся при первом запуске, дальше правится через /api/models.
# Любой OpenAI-совместимый API.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Заголовки через ";". Некоторые шлюзы отвергают дефолтный User-Agent SDK.
LLM_EXTRA_HEADERS=

# Лимит шлюза — 1 одновременный запрос на организацию (ключ общий на команду!).
LLM_CONCURRENCY=1
MAX_CONCURRENCY=2
QUESTION_TIMEOUT_S=900
