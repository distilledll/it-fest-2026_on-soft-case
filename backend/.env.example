# Настройки турнирного шлюза. Впишите выданный ключ в backend/.env.
BRIDGE_API_KEY=
PIPELINE=hybrid
LLM_BASE_URL=https://bridge-back.admlr.lipetsk.ru/api/v1
LLM_MODEL=cifra48/agent
LLM_API_KEY_ENV=BRIDGE_API_KEY
LLM_EXTRA_HEADERS=User-Agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
LLM_CONTEXT_TOKENS=131072
LLM_MAX_TOKENS=8000
LLM_CONCURRENCY=5
MAX_CONCURRENCY=5
LLM_RPS=2
QUESTION_TIMEOUT_S=600

# Резервный движок TrustQA. Отдельные ключи: QWEN_API_KEY, JINA_API_KEY.
QWEN_BASE_URL=https://bridge-back.admlr.lipetsk.ru/api/v1
QWEN_MODEL=cifra48/agent
QWEN_MODEL_VERSION=unversioned:cifra48/agent
QWEN_CONTEXT_TOKENS=131072
QWEN_MAX_OUTPUT_TOKENS=8000
QWEN_MAX_CALLS=16
QWEN_REASONING_EFFORT=low
JINA_BASE_URL=https://bridge-back.admlr.lipetsk.ru/api/v1
JINA_AUTH_HEADER=X-API-Key
JINA_EMBEDDING_MODEL=cifra48/embedding
JINA_EMBEDDING_VERSION=unversioned:cifra48/embedding
JINA_EMBEDDING_DIMENSIONS=1024
JINA_RERANKER_MODEL=cifra48/rerank
ALLOW_BM25=true
